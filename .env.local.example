# ── Clerk ────────────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com → Developers → Webhooks → Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create subscription products at stripe.com/products
# Pro plan ($9/mo)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# Teams plan ($19/mo)
STRIPE_TEAMS_MONTHLY_PRICE_ID=price_...
STRIPE_TEAMS_ANNUAL_PRICE_ID=price_...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=propflow

# ── Database (Railway Postgres) ───────────────────────────────────────────────
# railway.app → Your project → Postgres → Connect → DATABASE_URL
DATABASE_URL=postgresql://...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
